      "source": [
        "# ============================================================\n",
        "# EXPERIMENT 1\n",
        "# California Housing Price Analysis and Prediction\n",
        "# Data Exploration and Visualization\n",
        "# ============================================================\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 1. IMPORT REQUIRED LIBRARIES\n",
        "# ============================================================\n",
        "\n",
        "# Data Manipulation\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "\n",
        "# Visualization\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "\n",
        "# Display Settings\n",
        "pd.set_option(\"display.max_columns\", None)\n",
        "\n",
        "# Visualization Style\n",
        "sns.set_style(\"whitegrid\")\n",
        "plt.rcParams[\"figure.figsize\"] = (10, 6)\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 2. LOAD THE DATASET\n",
        "# ============================================================\n",
        "\n",
        "# Change the filename if your CSV has a different name\n",
        "df = pd.read_csv(\"/content/housing prices.csv\")\n",
        "\n",
        "# Display first 5 rows\n",
        "df.head()\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 3. DISPLAY LAST 5 ROWS\n",
        "# ============================================================\n",
        "\n",
        "df.tail()\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 4. DISPLAY NUMBER OF ROWS AND COLUMNS\n",
        "# ============================================================\n",
        "\n",
        "print(\"Rows :\", df.shape[0])\n",
        "print(\"Columns :\", df.shape[1])\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 5. DISPLAY DATASET INFORMATION\n",
        "# ============================================================\n",
        "\n",
        "df.info()\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 6. DESCRIPTIVE STATISTICS\n",
        "# ============================================================\n",
        "\n",
        "df.describe()\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 7. DESCRIPTIVE STATISTICS FOR CATEGORICAL DATA\n",
        "# ============================================================\n",
        "\n",
        "df.describe(include=\"object\")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 8. CHECK DATA TYPES\n",
        "# ============================================================\n",
        "\n",
        "print(\"Data Types:\")\n",
        "print(df.dtypes)\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 9. CHECK MISSING VALUES\n",
        "# ============================================================\n",
        "\n",
        "print(\"Missing Values:\")\n",
        "print(df.isnull().sum())\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 10. CHECK MISSING VALUE PERCENTAGE\n",
        "# ============================================================\n",
        "\n",
        "missing_percentage = (\n",
        "    df.isnull().sum() / len(df)\n",
        ") * 100\n",
        "\n",
        "print(\"Missing Value Percentage:\")\n",
        "print(missing_percentage)\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 11. CHECK DUPLICATE ROWS\n",
        "# ============================================================\n",
        "\n",
        "print(\"Number of Duplicate Rows:\", df.duplicated().sum())\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 12. CHECK NUMBER OF UNIQUE VALUES\n",
        "# ============================================================\n",
        "\n",
        "print(\"Unique Values in Each Column:\")\n",
        "print(df.nunique())\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 13. DISPLAY COLUMN NAMES\n",
        "# ============================================================\n",
        "\n",
        "print(\"Column Names:\")\n",
        "print(df.columns.tolist())\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 14. DISPLAY NUMERICAL COLUMNS\n",
        "# ============================================================\n",
        "\n",
        "numeric_columns = df.select_dtypes(\n",
        "    include=np.number\n",
        ").columns\n",
        "\n",
        "print(\"Numerical Columns:\")\n",
        "print(numeric_columns.tolist())\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 15. DISPLAY CATEGORICAL COLUMNS\n",
        "# ============================================================\n",
        "\n",
        "categorical_columns = df.select_dtypes(\n",
        "    include=\"object\"\n",
        ").columns\n",
        "\n",
        "print(\"Categorical Columns:\")\n",
        "print(categorical_columns.tolist())\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 16. HANDLE MISSING VALUES FOR EXPLORATION\n",
        "# ============================================================\n",
        "\n",
        "# The California Housing dataset contains missing values\n",
        "# in total_bedrooms.\n",
        "\n",
        "df_explore = df.copy()\n",
        "\n",
        "numeric_columns = df_explore.select_dtypes(\n",
        "    include=np.number\n",
        ").columns\n",
        "\n",
        "for column in numeric_columns:\n",
        "    df_explore[column] = df_explore[column].fillna(\n",
        "        df_explore[column].median()\n",
        "    )\n",
        "\n",
        "print(\"Missing Values After Handling:\")\n",
        "print(df_explore.isnull().sum())\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 17. CORRELATION MATRIX\n",
        "# ============================================================\n",
        "\n",
        "correlation_matrix = df_explore.corr(\n",
        "    numeric_only=True\n",
        ")\n",
        "\n",
        "print(\"Correlation Matrix:\")\n",
        "print(correlation_matrix)\n",
        "\n",
        "\n",
